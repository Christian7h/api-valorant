---
// filepath: c:\Users\crist\Desktop\ASTRO\api-valorant\src\pages\vps.astro
import Layout from "../layouts/Layout.astro";

// Función para obtener las marcas desde la API
async function getBrands() {
  try {
    const response = await fetch('https://www.crisdeus.site/brands');
    const data = await response.json();
    return data;
  } catch (error) {
    console.error('Error fetching brands:', error);
    return null;
  }
}

// Obtener los datos de las marcas
const brandsData = await getBrands();
---

<Layout title="VPS NodeJS API">
  <div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-4xl font-bold text-valorant">VPS NodeJS API - <span id="title-text">Marcas de Automóviles</span></h1>
      
      <!-- Selector de idioma -->
      <div class="flex items-center space-x-2">
        <span class="text-white text-sm" id="language-label">Idioma:</span>
        <button 
          id="language-toggle" 
          class="bg-valorant hover:bg-valorant-dark text-white px-4 py-2 rounded-lg transition duration-200 flex items-center space-x-2"
        >
          <span id="current-lang">🇪🇸 ES</span>
        </button>
      </div>
    </div>
    
    {brandsData ? (
      <div class="mb-6">
        <div class="bg-gray-800 rounded-lg p-4 mb-6">
          <h2 class="text-xl font-semibold text-white mb-2" id="api-info-title">Información de la API</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
            <div>
              <span class="text-gray-400" id="status-label">Estado:</span>
              <span class={brandsData.success ? "text-green-400 ml-2" : "text-red-400 ml-2"}>
                {brandsData.success ? "✓ Exitoso" : "✗ Error"}
              </span>
            </div>
            <div>
              <span class="text-gray-400" id="total-label">Total:</span>
              <span class="text-white ml-2">{brandsData.count} <span id="brands-text">marcas</span></span>
            </div>
            <div>
              <span class="text-gray-400" id="time-label">Tiempo:</span>
              <span class="text-white ml-2">{brandsData.responseTime}</span>
            </div>
            <div>
              <span class="text-gray-400">Cache:</span>
              <span class="text-white ml-2">{brandsData.cached ? "Sí" : "No"}</span>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="brands-container">
          {brandsData.data?.map((brand) => (
            <div key={brand.id} class="bg-valorant-dark p-6 rounded-lg shadow-lg border border-gray-700" data-brand-id={brand.id}>
              <h3 class="text-2xl font-bold text-valorant mb-3">{brand.name}</h3>
              
              <div class="space-y-3">
                <div>
                  <h4 class="text-sm font-semibold text-gray-300 uppercase tracking-wide description-label">Descripción</h4>
                  <p class="text-white brand-description" data-es={brand.translations.es.description} data-en={brand.translations.en.description}>
                    {brand.translations.es.description}
                  </p>
                </div>
                
                <div>
                  <h4 class="text-sm font-semibold text-gray-300 uppercase tracking-wide foundation-label">Fundación</h4>
                  <p class="text-white">{brand.foundation}</p>
                </div>
                
                <div>
                  <h4 class="text-sm font-semibold text-gray-300 uppercase tracking-wide history-label">Historia</h4>
                  <p class="text-gray-300 text-sm leading-relaxed brand-history" data-es={brand.translations.es.history} data-en={brand.translations.en.history}>
                    {brand.translations.es.history}
                  </p>
                </div>
                
                <div>
                  <h4 class="text-sm font-semibold text-gray-300 uppercase tracking-wide trajectory-label">Trayectoria</h4>
                  <p class="text-gray-300 text-sm leading-relaxed brand-trajectory" data-es={brand.translations.es.trajectory} data-en={brand.translations.en.trajectory}>
                    {brand.translations.es.trajectory}
                  </p>
                </div>
                
                <div class="pt-2 border-t border-gray-600">
                  <span class="inline-block bg-gray-700 text-gray-300 text-xs px-2 py-1 rounded">
                    ID: {brand.id}
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="bg-red-900 border border-red-700 rounded-lg p-6">
        <h2 class="text-xl font-semibold text-red-300 mb-2" id="error-title">Error al cargar los datos</h2>
        <p class="text-red-200" id="error-message">No se pudieron obtener los datos de la API. Verifica la conexión y vuelve a intentar.</p>
      </div>
    )}

    <div class="mt-8 bg-gray-800 rounded-lg p-6">
      <h2 class="text-2xl font-bold text-white mb-4" id="about-title">Acerca de esta API</h2>
      <p class="text-gray-300 mb-4" id="about-description">
        Esta API proporciona información detallada sobre marcas de automóviles, 
        incluyendo su historia, trayectoria y datos de fundación.
      </p>
      <div class="space-y-2">
        <p class="text-sm">
          <span class="text-gray-400">Endpoint:</span>
          <code class="bg-gray-700 px-2 py-1 rounded text-white ml-2">
            https://www.crisdeus.site/brands
          </code>
        </p>
        <p class="text-sm">
          <span class="text-gray-400" id="method-label">Método:</span>
          <span class="text-green-400 ml-2">GET</span>
        </p>
        <p class="text-sm">
          <span class="text-gray-400" id="response-label">Respuesta:</span>
          <span class="text-white ml-2" id="response-text">JSON con marcas automotrices</span>
        </p>
      </div>
    </div>
  </div>

  <script>
    // Traducciones
    const translations = {
      es: {
        title: "Marcas de Automóviles",
        languageLabel: "Idioma:",
        apiInfoTitle: "Información de la API",
        statusLabel: "Estado:",
        totalLabel: "Total:",
        timeLabel: "Tiempo:",
        brandsText: "marcas",
        descriptionLabel: "Descripción",
        foundationLabel: "Fundación",
        historyLabel: "Historia",
        trajectoryLabel: "Trayectoria",
        errorTitle: "Error al cargar los datos",
        errorMessage: "No se pudieron obtener los datos de la API. Verifica la conexión y vuelve a intentar.",
        aboutTitle: "Acerca de esta API",
        aboutDescription: "Esta API proporciona información detallada sobre marcas de automóviles, incluyendo su historia, trayectoria y datos de fundación.",
        methodLabel: "Método:",
        responseLabel: "Respuesta:",
        responseText: "JSON con marcas automotrices",
        currentLang: "🇪🇸 ES"
      },
      en: {
        title: "Automobile Brands",
        languageLabel: "Language:",
        apiInfoTitle: "API Information",
        statusLabel: "Status:",
        totalLabel: "Total:",
        timeLabel: "Time:",
        brandsText: "brands",
        descriptionLabel: "Description",
        foundationLabel: "Foundation",
        historyLabel: "History",
        trajectoryLabel: "Trajectory",
        errorTitle: "Error loading data",
        errorMessage: "Could not fetch data from the API. Check your connection and try again.",
        aboutTitle: "About this API",
        aboutDescription: "This API provides detailed information about automobile brands, including their history, trajectory and foundation data.",
        methodLabel: "Method:",
        responseLabel: "Response:",
        responseText: "JSON with automotive brands",
        currentLang: "🇬🇧 EN"
      }
    };

    let currentLanguage = 'es';

    function toggleLanguage() {
      currentLanguage = currentLanguage === 'es' ? 'en' : 'es';
      updateTexts();
      updateBrandData();
    }

    function updateTexts() {
      const lang = translations[currentLanguage];
      
      // Actualizar textos estáticos
      document.getElementById('title-text').textContent = lang.title;
      document.getElementById('language-label').textContent = lang.languageLabel;
      document.getElementById('current-lang').textContent = lang.currentLang;
      document.getElementById('api-info-title').textContent = lang.apiInfoTitle;
      document.getElementById('status-label').textContent = lang.statusLabel;
      document.getElementById('total-label').textContent = lang.totalLabel;
      document.getElementById('time-label').textContent = lang.timeLabel;
      document.getElementById('brands-text').textContent = lang.brandsText;
      
      // Actualizar labels de las tarjetas
      document.querySelectorAll('.description-label').forEach(el => {
        el.textContent = lang.descriptionLabel;
      });
      document.querySelectorAll('.foundation-label').forEach(el => {
        el.textContent = lang.foundationLabel;
      });
      document.querySelectorAll('.history-label').forEach(el => {
        el.textContent = lang.historyLabel;
      });
      document.querySelectorAll('.trajectory-label').forEach(el => {
        el.textContent = lang.trajectoryLabel;
      });

      // Actualizar sección de error si existe
      const errorTitle = document.getElementById('error-title');
      const errorMessage = document.getElementById('error-message');
      if (errorTitle) errorTitle.textContent = lang.errorTitle;
      if (errorMessage) errorMessage.textContent = lang.errorMessage;

      // Actualizar sección "Acerca de"
      document.getElementById('about-title').textContent = lang.aboutTitle;
      document.getElementById('about-description').textContent = lang.aboutDescription;
      document.getElementById('method-label').textContent = lang.methodLabel;
      document.getElementById('response-label').textContent = lang.responseLabel;
      document.getElementById('response-text').textContent = lang.responseText;
    }

    function updateBrandData() {
      // Actualizar contenido de las marcas
      document.querySelectorAll('.brand-description').forEach(el => {
        el.textContent = el.getAttribute(`data-${currentLanguage}`);
      });
      document.querySelectorAll('.brand-history').forEach(el => {
        el.textContent = el.getAttribute(`data-${currentLanguage}`);
      });
      document.querySelectorAll('.brand-trajectory').forEach(el => {
        el.textContent = el.getAttribute(`data-${currentLanguage}`);
      });
    }

    // Agregar evento al botón
    document.getElementById('language-toggle').addEventListener('click', toggleLanguage);
  </script>
</Layout>