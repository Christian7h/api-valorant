---
import LayoutWithCache from "../layouts/LayoutWithCache.astro";

const apiUrl =
  "https://restapi-characters-78ea06df0a06.herokuapp.com/api/getAll";

let characters = [];
let error = null;
let validRaces = ["Humano", "Elfo", "Enano", "Orco", "Demonio", "Dragón"];
let validClasses = [
  "Guerrero",
  "Mago",
  "Ladrón",
  "Arquero",
  "Hechicero",
  "Paladín",
];

try {
  const res = await fetch(apiUrl);
  characters = await res.json();
} catch (err) {
  error = "Error obteniendo los personajes. Inténtalo más tarde.";
}

interface Character {
  _id: string;
  name: string;
  age: number;
  race: string;
  characterClass: string;
  level: number;
  health: number;
  inventory: string[];
  createdAt: Date;
  updatedAt: Date;
  __v: number;
}
---

<LayoutWithCache>
  <div class="container mx-auto p-4 md:p-8">
    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-valorant mb-2">
        Personajes de Fantasía
      </h1>
      {
        !characters.length && !error && (
          <p class="text-valorant/80">Cargando personajes...</p>
        )
      }
    </header>
    <!-- Formulario para agregar un nuevo personaje -->
    <div class="bg-valorant-dark p-6 rounded-lg shadow-lg mb-8">
      <h2 class="text-2xl font-semibold text-valorant mb-4">
        Agregar Nuevo Personaje
      </h2>
      <form id="create-character-form">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input
            type="text"
            id="name"
            placeholder="Nombre"
            required
            class="p-2 bg-gray-800 text-white rounded"
          />
          <input
            type="number"
            id="age"
            placeholder="Edad"
            required
            class="p-2 bg-gray-800 text-white rounded"
          />

          <select id="race" required class="p-2 bg-gray-800 text-white rounded">
            <option value="">Selecciona una raza</option>
            {validRaces.map((race) => <option value={race}>{race}</option>)}
          </select>

          <select
            id="characterClass"
            required
            class="p-2 bg-gray-800 text-white rounded"
          >
            <option value="">Selecciona una clase</option>
            {
              validClasses.map((characterClass) => (
                <option value={characterClass}>{characterClass}</option>
              ))
            }
          </select>

          <input
            type="number"
            id="level"
            placeholder="Nivel (Opcional)"
            class="p-2 bg-gray-800 text-white rounded"
          />
          <input
            type="number"
            id="health"
            placeholder="Salud (Opcional)"
            class="p-2 bg-gray-800 text-white rounded"
          />
          <input
            type="text"
            id="inventory"
            placeholder="Inventario (separado por comas)"
            class="p-2 bg-gray-800 text-white rounded"
          />
        </div>

        <button
          type="submit"
          class="mt-4 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition"
        >
          Crear Personaje
        </button>
      </form>
    </div>
    {
      error ? (
        <div
          role="alert"
          class="p-4 bg-red-100 text-red-700 rounded-lg flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
              clip="evenodd"
            />
          </svg>
          {error}
        </div>
      ) : (
        <div
          id="characters-container"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6"
        >
          {characters.map((character: Character) => (
            <article
              key={character._id}
              class="group relative bg-valorant-dark p-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 focus-within:ring-2 ring-valorant outline-none"
              tabIndex={0}
              aria-labelledby={`character-${character._id}-title`}
            >
              <h2
                id={`character-${character._id}-title`}
                class="text-xl font-semibold text-valorant mb-2 truncate"
                title={character.name}
              >
                {character.name}
              </h2>

              <dl class="space-y-2 text-gray-300">
                <div class="flex justify-between">
                  <dt class="font-medium">Edad</dt>
                  <dd>{character.age}</dd>
                </div>
                <div class="flex justify-between">
                  <dt class="font-medium">Raza</dt>
                  <dd class="truncate" title={character.race}>
                    {character.race}
                  </dd>
                </div>
                <div class="flex justify-between">
                  <dt class="font-medium">Clase</dt>
                  <dd class="truncate" title={character.characterClass}>
                    {character.characterClass}
                  </dd>
                </div>
                <div class="flex justify-between">
                  <dt class="font-medium">Nivel</dt>
                  <dd>{character.level}</dd>
                </div>
                <div class="flex justify-between">
                  <dt class="font-medium">Salud</dt>
                  <dd>
                    <span class="sr-only">{character.health}</span>
                    <progress
                      value={character.health}
                      max="100"
                      class="w-24 h-2 bg-gray-700 rounded"
                      aria-label={`Salud de ${character.name}`}
                    />
                  </dd>
                </div>
              </dl>

              {character.inventory.length > 0 && (
                <div class="mt-4 pt-2 border-t border-gray-700">
                  <p
                    class="text-sm text-gray-400 truncate"
                    title={character.inventory.join(", ")}
                  >
                    <span class="font-medium">Inventario:</span>{" "}
                    {character.inventory.join(", ")}
                  </p>
                </div>
              )}

              <button
                class="mt-4 w-full bg-red-600/80 hover:bg-red-700 text-white px-4 py-2 rounded transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 focus:ring-offset-valorant-dark"
                data-id={character._id}
                aria-label={`Eliminar personaje ${character.name}`}
                onClick={(e) => {
                  if (
                    !confirm(`¿Estás seguro de eliminar a ${character.name}?`)
                  ) {
                    e.preventDefault();
                  }
                }}
              >
                Eliminar
              </button>
            </article>
          ))}
        </div>
      )
    }
  </div>
</LayoutWithCache>
<script is:inline>
  const deleteUrl =
    "https://restapi-characters-78ea06df0a06.herokuapp.com/api/delete";
  const form = document.getElementById("create-character-form");
  const createUrl =
    "https://restapi-characters-78ea06df0a06.herokuapp.com/api/post";

  document.addEventListener("DOMContentLoaded", function () {
    const buttons = document.querySelectorAll(".delete-btn");
    buttons.forEach((button) => {
      button.addEventListener("click", async (event) => {
        const characterId = event.target.dataset.id;
        const card = document.getElementById(`card-${characterId}`);

        if (confirm("¿Estás seguro de que quieres eliminar este personaje?")) {
          try {
            const response = await fetch(`${deleteUrl}/${characterId}`, {
              method: "DELETE",
            });

            if (!response.ok) {
              throw new Error("Error al eliminar el personaje");
            }

            // Eliminar la card del DOM sin recargar la página
            card.remove();
          } catch (error) {
            console.error(error);
            alert("Hubo un problema al eliminar el personaje.");
          }
        }
      });
    });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const name = document.getElementById("name").value;
      const age = document.getElementById("age").value;
      const race = document.getElementById("race").value;
      const characterClass = document.getElementById("characterClass").value;
      const level = document.getElementById("level").value || 1;
      const health = document.getElementById("health").value || 100;
      const inventory = document
        .getElementById("inventory")
        .value.split(",")
        .map((item) => item.trim());

      if (!name || !age || !race || !characterClass) {
        alert("Por favor, completa todos los campos obligatorios.");
        return;
      }

      try {
        const response = await fetch(createUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name,
            age,
            race,
            characterClass,
            level,
            health,
            inventory,
          }),
        });

        if (!response.ok) {
          throw new Error("Error al crear el personaje.");
        }

        const newCharacter = await response.json();
        alert("Personaje creado exitosamente.");
        window.location.reload(); // Recargar la página para ver el nuevo personaje
      } catch (error) {
        console.error(error);
        alert("Hubo un problema al crear el personaje.");
      }
    });
  });
</script>
<style>
  .bg-valorant-dark {
    background-color: #1f2937;
  }
  .text-valorant {
    color: #10b981;
  }
</style>
